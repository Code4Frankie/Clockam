NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/clockam
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Comma-separated list of allowed browser origins (web app, kiosk)
CORS_ORIGINS=http://localhost:5173

# WebAuthn (phone / Windows Hello / FIDO fingerprint)
# RP ID = the domain of your web app (no protocol, no port). Use "localhost" in dev.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=ClockAm
# Exact origin of the web app, including protocol and port
WEBAUTHN_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Assistant (add these in the RENDER dashboard only. Never on Vercel, never with a VITE_ prefix.)
# Without ANTHROPIC_API_KEY the assistant endpoint answers 503 and the rest of ClockAm works as before.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AGENT_MAX_STEPS=8
AGENT_TIMEOUT_MS=60000
AGENT_RATE_LIMIT_PER_MIN=20
AGENT_CONFIRM_TTL_SECONDS=300
AGENT_LOG_RETENTION_DAYS=90

# Frankiecode staff who may open the Site audit page: comma-separated USER IDS (not emails, because
# sign-up emails are not verified). Get yours from GET /api/auth/me after signing in: user.id
PLATFORM_ADMIN_USER_IDS=

# ---------------------------------------------------------------------------
# Site auditor (node apps/api/src/seo/crawl.js). Also used by the weekly GitHub Action.
# ---------------------------------------------------------------------------
SEO_BASE_URL=http://localhost:5173
SEO_API_URL=http://localhost:4000
SEO_CRAWL_DELAY_MS=500
SEO_MAX_PAGES=50
